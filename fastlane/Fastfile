SIGNING_IDENTITY_MARKERS = [
  "Apple Development",
  "Apple Distribution",
  "3rd Party Mac Developer Installer"
].freeze

desc "Verify the existing dedicated build keychain and reusable team signing identities without creating certificates."
lane :signing_certificates do
  unlock_and_verify_build_keychain_identities
end

platform :ios do
  before_all do
    app_store_connect_api_key(**API_KEY)
  end

  desc "Register the universal Developer Portal bundle ID using the App Store Connect API key. Idempotent."
  lane :register_bundle_ids do
    register_universal_bundle_id
  end

  desc "Create the App Store Connect app record for Arkham if needed (record id 6822282565 exists). Requires Apple ID + 2FA; do not run non-interactively."
  lane :create_app_record do
    create_arkham_horror_app_record
  end

  desc "Print the App Store Connect app record and version states."
  lane :asc_status do
    print_asc_status
  end

  desc "Archive/export the iOS Release build with xbuild and upload it to internal TestFlight."
  lane :beta do |options|
    upload_beta(:ios, options)
  end
end

