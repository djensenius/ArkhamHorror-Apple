DEVELOPER_DIR = "/Applications/Xcode.app/Contents/Developer"
# xcode-select on the build host points at the Command Line Tools. fastlane's
# Helper.xcode_path ignores DEVELOPER_DIR and reads `xcode-select -p`, so pilot
# cannot find xcodebuild/iTMSTransporter (nil xcode_version). Point fastlane at
# full Xcode for this process only instead of changing xcode-select system-wide.
ENV["DEVELOPER_DIR"] = DEVELOPER_DIR
FastlaneCore::Helper.define_singleton_method(:xcode_path) { "#{DEVELOPER_DIR}/" }
ARCHIVE_ROOT = File.join(REPO_ROOT, "fastlane/archives")
BUILD_ROOT = File.join(REPO_ROOT, "fastlane/builds")
XBUILD = "xbuild"

# Release/TestFlight builds require no Developer Portal capabilities beyond the
# default universal App ID. macOS sandbox and network-client entitlements are
# local signing entitlements and do not need a portal capability toggle.
REQUIRED_CAPABILITIES = {}.freeze

XBUILD_AUTH_ARGS = [
  "-allowProvisioningUpdates",
  "-authenticationKeyPath", API_KEY[:key_filepath],
  "-authenticationKeyID", API_KEY[:key_id],
  "-authenticationKeyIssuerID", API_KEY[:issuer_id]
].freeze

# Dedicated signing keychain shared with the owner's other apps. These defaults
# can be overridden by environment for another build host. The password file
# holds a random password for this keychain only; never print or commit it.
BUILD_KEYCHAIN_PATH = File.expand_path(
  ENV.fetch("ARKHAM_BUILD_KEYCHAIN_PATH", "~/Library/Keychains/canadian-ham-build.keychain-db")
)
BUILD_KEYCHAIN_PASSWORD_FILE = File.expand_path(
  ENV.fetch("ARKHAM_BUILD_KEYCHAIN_PASSWORD_FILE", "~/.appstoreconnect/build-keychain.pw")
)

